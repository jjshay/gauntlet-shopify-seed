{
  "sections": {
    "featured-collection": {
      "type": "featured-collection",
      "settings": {
        "title": "",
        "collection": "",
        "products_to_show": 25,
        "show_view_all": false,
        "grid_type": "justified",
        "mobile_columns": "2",
        "desktop_columns": 5,
        "standard_layout_align_items": "items-start",
        "modular_layout_variation": 1,
        "modular_grid_item_aspect_ratio": 1,
        "irregular_layout_variation": 1,
        "irregular_alignment_of_items": "items-center justify-center",
        "media_aspect_ratio": "natural",
        "media_fill_space": false,
        "labels_show_titles_and_captions": true,
        "labels_show_product_prices": false,
        "labels_display": "text_overlay_on_hover",
        "labels_show_product_vendor": false,
        "labels_always_show_on_mobile": false,
        "quick_view": "disabled",
        "color_scheme": "",
        "space_above": 0.5,
        "space_below": 1,
        "disable_left_and_right_margins": false,
        "remove_grid_gaps": false
      }
    },
    "feature-text": {
      "type": "feature-text",
      "settings": {
        "richtext": "<p>Welcome to our art shop, located in the vibrant city of Zurich, where creativity meets inspiration. As an established hub for art lovers and collectors, we pride ourselves on curating a diverse collection of artworks from both renowned and emerging artists.<\/p>",
        "cta_label": "Shop collection",
        "font": "font-heading",
        "desktop_text_scale": 5,
        "mobile_text_scale": 2,
        "text_alignment": "text-left",
        "content_width_on_desktop": "12",
        "content_position_on_desktop": "left",
        "show_top_border": false,
        "color_scheme": "",
        "space_above": 1,
        "space_below": 1
      }
    },
    "text-columns": {
      "type": "text-columns",
      "blocks": {
        "text-columns-0": {
          "type": "column",
          "settings": {
            "icon": "globe",
            "title": "International Exhibitions",
            "text": "<p>We collaborate with renowned galleries and artists from around the world to bring you extraordinary collections.<\/p>",
            "cta_link": "",
            "cta_label": ""
          }
        },
        "text-columns-1": {
          "type": "column",
          "settings": {
            "icon": "truck",
            "title": "Seamless Art Acquisition",
            "text": "<p>We handle the logistics to ensure your artwork arrives safely and securely, ready to adorn your living space with beauty and inspiration.<\/p>",
            "cta_link": "",
            "cta_label": ""
          }
        },
        "text-columns-2": {
          "type": "column",
          "settings": {
            "icon": "star",
            "title": "Emerging Talents",
            "text": "<p>Discover the works of talented emerging artists who are pushing boundaries and making their mark in the art world. <\/p>",
            "cta_link": "",
            "cta_label": ""
          }
        },
        "text-columns-3": {
          "type": "column",
          "settings": {
            "icon": "heart",
            "title": "Curated Collections",
            "text": "<p>Our expert curators meticulously select artworks that harmonize in theme, style, and historical significance.<\/p>",
            "cta_link": "",
            "cta_label": ""
          }
        }
      },
      "block_order": [
        "text-columns-0",
        "text-columns-1",
        "text-columns-2",
        "text-columns-3"
      ],
      "settings": {
        "desktop_columns": 4,
        "text_alignment": "text-center",
        "max_width_of_icons": 80,
        "show_top_border": true,
        "color_scheme": "",
        "space_above": 1,
        "space_below": 1
      }
    },
